{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expression-scaffold-output.v2",
  "title": "LinguaType expression scaffold output v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceZh", "action", "focusZh", "recommendedExpression", "focusOptionsZh"],
            "properties": {
              "sourceZh": { "type": "string", "minLength": 1 },
              "action": { "const": "provide_expression" },
              "focusZh": { "type": "string", "minLength": 1 },
              "recommendedExpression": { "type": "string", "minLength": 1 },
              "focusOptionsZh": { "type": "array", "maxItems": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceZh", "action", "focusZh", "recommendedExpression", "focusOptionsZh"],
            "properties": {
              "sourceZh": { "type": "string", "minLength": 1 },
              "action": { "const": "request_focus" },
              "focusZh": { "type": "null" },
              "recommendedExpression": { "type": "null" },
              "focusOptionsZh": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
