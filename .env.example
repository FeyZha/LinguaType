# Optional public-demo mode for Vercel.
# Do not put real secrets in GitHub. Set the real key in Vercel Project Settings.
NEXT_PUBLIC_LINGUATYPE_DEMO_API_ENABLED=false

# Server-side provider settings. These are read only by Next.js API routes.
LINGUATYPE_API_PROVIDER=openai-compatible
LINGUATYPE_API_BASE_URL=https://api.openai.com
LINGUATYPE_API_ENDPOINT_PATH=/v1/chat/completions
LINGUATYPE_API_MODEL=
LINGUATYPE_API_KEY=
LINGUATYPE_API_TEMPERATURE=0.2
LINGUATYPE_API_MAX_TOKENS=20000
LINGUATYPE_API_SUPPORTS_JSON_MODE=false
